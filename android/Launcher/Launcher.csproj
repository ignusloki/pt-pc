<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ApplicationId>org.ignusloki.pt.prototype</ApplicationId>
    <ApplicationTitle>P.T. Android Prototype</ApplicationTitle>
    <ApplicationDisplayVersion>1.0.10-android-beta.5</ApplicationDisplayVersion>
    <ApplicationVersion>15</ApplicationVersion>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <PublishTrimmed>false</PublishTrimmed>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Keep managed callbacks on the tested dynamic JNI registration path.
         Native CPU variants must stay lazily loaded, including in Release. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <AndroidIgnoreAllJniPreload>true</AndroidIgnoreAllJniPreload>
    <AndroidManifest>AndroidManifest.xml</AndroidManifest>
    <PtAndroidStage Condition="'$(PtAndroidStage)' == ''">../../build/android-prototype/stage</PtAndroidStage>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationId>org.ignusloki.pt.beta</ApplicationId>
    <ApplicationTitle>P.T. Android Beta</ApplicationTitle>
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidUseApkSigner>true</AndroidUseApkSigner>
  </PropertyGroup>
  <Target Name="RequireReleaseSigning" BeforeTargets="PrepareForBuild" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="'$(AndroidSigningKeyStore)' == '' or '$(AndroidSigningKeyAlias)' == '' or '$(AndroidSigningKeyPass)' == '' or '$(AndroidSigningStorePass)' == ''"
           Text="Android beta Release builds require an explicit signing key. Use tools/android/build.py with --keystore, --key-alias and --password-file." />
  </Target>
  <ItemGroup>
    <AndroidResource Include="$(PtAndroidStage)/resources/drawable/pt_icon.png" Link="Resources/drawable/pt_icon.png" />
    <Compile Include="../../installer/Extractor/Program.cs" Link="Extraction.cs" />
    <ProjectReference Include="$(LibOrbisSource)/LibOrbisPkg.Core/LibOrbisPkg.Core.csproj" Condition="'$(LibOrbisSource)' != ''" />
    <AndroidJavaSource Include="$(PtAndroidStage)/java/**/*.java" Bind="false" />
    <AndroidJavaSource Update="Java/**/*.java" Bind="false" />
    <AndroidNativeLibrary Include="$(PtAndroidStage)/lib/arm64-v8a/*.so" Abi="arm64-v8a" />
    <AndroidAsset Include="$(PtAndroidStage)/assets/**/*" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
