#version 460
#extension GL_EXT_ray_query : require
#ifndef PT_D3D12
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#endif
#include "common.glsl"
#include "rt_shadow.glsl"
#include "rt_full.glsl"
#include "pt_path.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform PassPush {
    uvec4 ids;
    vec4 f0;
    vec4 f1;
    vec4 f2;
    mat4 m;
} pass;

#include "pt_images.glsl"

View v;

float Cutoff() {
    return 1.0e-4 / max(v.exposure.x, 1.0e-12);
}

struct PrimarySurface {
    vec3 normal;
    vec3 tangent;
    vec3 bitangent;
    vec2 uv;
    uint material;
};

PrimarySurface PrimaryHit(uint record, uint primitive, vec2 bary, mat4x3 to_world, vec3 ray) {
    RtRecord r = rt_records[record];
    RtIndexRef ib = RT_INDEX_REF(r.indices);
    RtVertexRef vb = RT_VERTEX_REF(r.vertices);
    uint base = r.first_index + 3u * primitive;
    uint a = (RT_INDEX(ib, base) + uint(r.vertex_offset)) * 22u;
    uint b = (RT_INDEX(ib, base + 1u) + uint(r.vertex_offset)) * 22u;
    uint c = (RT_INDEX(ib, base + 2u) + uint(r.vertex_offset)) * 22u;
    vec3 w = vec3(1.0 - bary.x - bary.y, bary.x, bary.y);
    PrimarySurface s;
    s.uv = vec2(RT_VERTEX(vb, a + 10u), RT_VERTEX(vb, a + 11u)) * w.x + vec2(RT_VERTEX(vb, b + 10u), RT_VERTEX(vb, b + 11u)) * w.y +
           vec2(RT_VERTEX(vb, c + 10u), RT_VERTEX(vb, c + 11u)) * w.z;
    vec3 n = vec3(RT_VERTEX(vb, a + 3u), RT_VERTEX(vb, a + 4u), RT_VERTEX(vb, a + 5u)) * w.x +
             vec3(RT_VERTEX(vb, b + 3u), RT_VERTEX(vb, b + 4u), RT_VERTEX(vb, b + 5u)) * w.y +
             vec3(RT_VERTEX(vb, c + 3u), RT_VERTEX(vb, c + 4u), RT_VERTEX(vb, c + 5u)) * w.z;
    vec3 t = vec3(RT_VERTEX(vb, a + 6u), RT_VERTEX(vb, a + 7u), RT_VERTEX(vb, a + 8u)) * w.x +
             vec3(RT_VERTEX(vb, b + 6u), RT_VERTEX(vb, b + 7u), RT_VERTEX(vb, b + 8u)) * w.y +
             vec3(RT_VERTEX(vb, c + 6u), RT_VERTEX(vb, c + 7u), RT_VERTEX(vb, c + 8u)) * w.z;
    float sign_w = RT_VERTEX(vb, a + 9u) < 0.0 ? -1.0 : 1.0;
    vec3 nw = mat3(to_world) * n;
    vec3 tw = mat3(to_world) * t;
    nw = dot(nw, nw) > 1.0e-12 ? normalize(nw) : -ray;
    tw = dot(tw, tw) > 1.0e-12 ? normalize(tw) : vec3(1.0, 0.0, 0.0);
    s.bitangent = sign_w * normalize(cross(nw, tw) + vec3(0.0, 0.0, 1.0e-9));
    s.tangent = tw;
    s.normal = nw;
    if (dot(nw, ray) > 0.0) {
        s.normal = -nw;
    }
    s.material = r.material;
    return s;
}

PtMaterial PrimaryMaterial(Material m, PrimarySurface ps, bool front, out vec3 n) {
    PtMaterial s;
    s.albedo = (m.flags & MAT_CONSTANT_COLOR) != 0u ? m.albedo_factor.rgb : textureLod(PT_TEX2D(m.albedo), ps.uv, 0.0).rgb;
    n = ps.normal;
    if ((m.flags & MAT_NORMAL_MAP) != 0u) {
        vec4 nt = textureLod(PT_TEX2D(m.normal), ps.uv, 0.0);
        vec2 nxy = vec2(nt.w, nt.y) * 2.0 - 1.0;
        float nz = sqrt(Saturate(1.0 - dot(nxy, nxy)) + 1.00016594e-4);
        vec3 geo = front ? ps.normal : -ps.normal;
        vec3 mapped = normalize(ps.tangent * nxy.x + ps.bitangent * nxy.y + geo * nz);
        n = dot(mapped, ps.normal) > 0.0 ? mapped : ps.normal;
    }
    vec4 srm = (m.flags & MAT_NORMAL_WAVE) != 0u ? vec4(m.extra.x, m.extra.y, 0.0, 0.0) : textureLod(PT_TEX2D(m.specular), ps.uv, 0.0);
    s.specular = srm.r;
    s.roughness = srm.g;
    s.material_u = m.indices.x;
    s.translucency = (m.flags & MAT_TRANSLUCENT_TEX) != 0u ? textureLod(PT_TEX2D(m.aux1), ps.uv, 0.0).y
                     : (m.flags & MAT_NORMAL_WAVE) != 0u ? m.extra.z : 0.0;
    PtMaterialRows(s);
    return s;
}

vec3 CameraPath(vec2 frag, inout uint rng) {
    vec2 ndc = frag * v.viewport.zw * 2.0 - 1.0;
    vec3 dir = normalize(mat3(v.inv_view) * normalize(vec3(ndc * v.projection_param.xy, 1.0)));
    vec3 origin = v.eye.xyz;
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    float reach = pass.f0.z;
    uint bounces = uint(pass.f0.y + 0.5);
    uint primary_mask = 4u;
    for (int mirror = 0; mirror < 3; ++mirror) {
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, rt_casters, gl_RayFlagsCullBackFacingTrianglesEXT, primary_mask, origin, 0.0, dir, 200.0);
        while (rayQueryProceedEXT(rq)) {
            if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&
                PtCasterOpaque(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false), rayQueryGetIntersectionPrimitiveIndexEXT(rq, false),
                               rayQueryGetIntersectionBarycentricsEXT(rq, false), RtRandom(rng))) {
                rayQueryConfirmIntersectionEXT(rq);
            }
        }
        bool hit = rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
        float t = hit ? rayQueryGetIntersectionTEXT(rq, true) : 200.0;
        vec3 glass_point;
        vec3 glass_normal;
        if (PtLayers(origin, dir, t, 32.0, radiance, throughput, rng, glass_point, glass_normal)) {
            origin = glass_point + glass_normal * 0.002;
            dir = reflect(dir, glass_normal);
            continue;
        }
        if (!hit) {
            return radiance;
        }
        uint record = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
        PrimarySurface ps = PrimaryHit(record, rayQueryGetIntersectionPrimitiveIndexEXT(rq, true), rayQueryGetIntersectionBarycentricsEXT(rq, true),
                                       rayQueryGetIntersectionObjectToWorldEXT(rq, true), dir);
        Material m = materials[ps.material];
        vec3 p = origin + dir * t;
        if (m.kind == KIND_PARALLAX) {
            vec4 dirt = m.params.w > 0.5 ? textureLod(PT_TEX2D(m.aux2), clamp(ps.uv, 0.0, 1.0), 0.0) : vec4(0.0);
            if (RtRandom(rng) < Saturate(dirt.a)) {
                PtMaterial ds;
                ds.albedo = SrgbDecode(dirt.rgb);
                ds.roughness = 1.0;
                ds.specular = 0.0;
                ds.material_u = m.indices.x;
                ds.translucency = 0.0;
                PtMaterialRows(ds);
                vec3 o = p + ps.normal * 0.002;
                radiance += throughput * PtNextEvent(p, ps.normal, -dir, ds, o, pass.ids.y, Cutoff(), rng);
                float first_d;
                return radiance + PtTracePath(o, PtCosineDirection(ps.normal, vec2(RtRandom(rng), RtRandom(rng))), throughput * ds.albedo, bounces,
                                              reach, 0.0, pass.ids.y, Cutoff(), rng, first_d);
            }
            origin = p + ps.normal * 0.002;
            dir = reflect(dir, ps.normal);
            primary_mask = 4u | 2u;
            continue;
        }
        if (m.kind == KIND_SKY || m.kind == KIND_CONSTANT) {
            vec4 tex = textureLod(PT_TEX2D(m.albedo), ps.uv, 0.0);
            return radiance + throughput * min(vec3(32.0), m.albedo_factor.rgb * tex.rgb * m.params.y) * Saturate(m.albedo_factor.a * tex.a);
        }
        if (m.kind != KIND_DEFERRED) {
            return radiance;
        }
        vec3 n;
        PtMaterial s = PrimaryMaterial(m, ps, rayQueryGetIntersectionFrontFaceEXT(rq, true), n);
        if (pass.f0.w > 2.5) {
            vec3 sum = vec3(0.0);
            for (uint i = 0u; i < pass.ids.y; ++i) {
                Light l = frame.lights[i];
                vec3 d;
                vec3 sp;
                if (l.shadow_cone.w >= 0.0 && PtLightEval(l, p, n, -dir, s, Cutoff(), d, sp)) {
                    sum += s.albedo * d + sp;
                }
            }
            return sum;
        }
        if (pass.f0.w > 0.5) {
            return (pass.f0.w > 1.5 ? n * 0.5 + 0.5 : s.albedo) / max(v.exposure.x, 1.0e-12);
        }
        vec3 V = -dir;
        vec3 next = p + ps.normal * max(0.002, 0.001 * t);
        if (pass.f1.w > 0.5) {
            float a = PtCoatAmount(n, ps.normal, mat3(v.view) * n, pass.f1.xyz, s.roughness, pass.f2.x, pass.f2.y);
            if (a > 0.0 && RtRandom(rng) < a) {
                vec3 d = PtCoatDirection(n, ps.normal, V, s.roughness, vec2(RtRandom(rng), RtRandom(rng)));
                float first_c;
                return radiance + PtTracePath(next, d, throughput, bounces, reach, 0.0, pass.ids.y, Cutoff(), rng, first_c);
            }
        }
        radiance += throughput * PtNextEvent(p, n, V, s, next, pass.ids.y, Cutoff(), rng);
        vec3 spec_albedo = PtSpecularAlbedo(n, V, s);
        float ls = Luma709(spec_albedo);
        float ld = Luma709(s.albedo);
        if (!(ls + ld > 1.0e-5)) {
            return radiance;
        }
        float p_spec = clamp(ls / (ls + ld), 0.0, 1.0);
        vec3 next_dir;
        if (RtRandom(rng) < p_spec) {
            vec3 weight;
            if (!PtSampleSpecular(n, V, s, vec2(RtRandom(rng), RtRandom(rng)), next_dir, weight)) {
                return radiance;
            }
            throughput *= weight / max(p_spec, 1.0e-4);
        } else {
            next_dir = PtCosineDirection(n, vec2(RtRandom(rng), RtRandom(rng)));
            throughput *= s.albedo / max(1.0 - p_spec, 1.0e-4);
        }
        if (dot(next_dir, ps.normal) <= 0.0) {
            return radiance;
        }
        float first;
        if (bounces == 0u) {
            return radiance;
        }
        radiance += PtTracePath(next, next_dir, throughput, bounces, reach, 0.0, pass.ids.y, Cutoff(), rng, first);
        return radiance;
    }
    return radiance;
}

void main() {
    v = frame.views[pass.ids.x];
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(v.viewport.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) {
        return;
    }
    uint rng = RtHash(uint(pixel.x) * 1973u + uint(pixel.y) * 9277u) ^ RtHash(pass.ids.z * 26699u + 17u);
    vec4 sum = pass.ids.w != 0u ? vec4(0.0) : imageLoad(pt_reference_accum, pixel);
    uint samples = max(uint(pass.f0.x + 0.5), 1u);
    for (uint i = 0u; i < samples; ++i) {
        vec2 frag = vec2(pixel) + vec2(RtRandom(rng), RtRandom(rng));
        vec3 c = CameraPath(frag, rng);
        if (!any(isnan(c)) && !any(isinf(c))) {
            sum += vec4(c, 1.0);
        }
    }
    imageStore(pt_reference_accum, pixel, sum);
}
