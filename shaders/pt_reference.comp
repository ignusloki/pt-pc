#version 460
#include "pt_reference_surface.glsl"

vec3 CameraPath(vec2 frag, inout uint rng) {
    vec2 ndc = frag * v.viewport.zw * 2.0 - 1.0;
    vec3 dir = normalize(mat3(v.inv_view) * normalize(vec3(ndc * v.projection_param.xy, 1.0)));
    vec3 origin = v.eye.xyz;
    vec3 radiance = vec3(0.0);
    vec3 throughput = vec3(1.0);
    float reach = pass.f0.z;
    uint bounces = uint(pass.f0.y + 0.5);
    uint primary_mask = 4u;
    for (int mirror = 0; mirror < 3; ++mirror) {
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, rt_casters, gl_RayFlagsCullBackFacingTrianglesEXT, primary_mask, origin, 0.0, dir, 200.0);
        while (rayQueryProceedEXT(rq)) {
            if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&
                PtCasterOpaque(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false), rayQueryGetIntersectionPrimitiveIndexEXT(rq, false),
                               rayQueryGetIntersectionBarycentricsEXT(rq, false), RtRandom(rng))) {
                rayQueryConfirmIntersectionEXT(rq);
            }
        }
        bool hit = rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT;
        float t = hit ? rayQueryGetIntersectionTEXT(rq, true) : 200.0;
        vec3 glass_point;
        vec3 glass_normal;
        if (PtLayers(origin, dir, t, 32.0, radiance, throughput, rng, glass_point, glass_normal)) {
            origin = glass_point + glass_normal * 0.002;
            dir = reflect(dir, glass_normal);
            continue;
        }
        if (!hit) {
            return radiance;
        }
        uint record = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
        PrimarySurface ps = PrimaryHit(record, rayQueryGetIntersectionPrimitiveIndexEXT(rq, true), rayQueryGetIntersectionBarycentricsEXT(rq, true),
                                       rayQueryGetIntersectionObjectToWorldEXT(rq, true), dir);
        Material m = materials[ps.material];
        vec3 p = origin + dir * t;
        if (m.kind == KIND_PARALLAX) {
            vec4 dirt = m.params.w > 0.5 ? textureLod(PT_TEX2D(m.aux2), clamp(ps.uv, 0.0, 1.0), 0.0) : vec4(0.0);
            if (RtRandom(rng) < Saturate(dirt.a)) {
                PtMaterial ds;
                ds.albedo = SrgbDecode(dirt.rgb);
                ds.roughness = 1.0;
                ds.specular = 0.0;
                ds.material_u = m.indices.x;
                ds.translucency = 0.0;
                PtMaterialRows(ds);
                vec3 o = p + ps.normal * 0.002;
                radiance += throughput * PtNextEvent(p, ps.normal, -dir, ds, o, pass.ids.y, Cutoff(), rng);
                float first_d;
                return radiance + PtTracePath(o, PtCosineDirection(ps.normal, vec2(RtRandom(rng), RtRandom(rng))), throughput * ds.albedo, bounces,
                                              reach, 0.0, pass.ids.y, Cutoff(), rng, first_d);
            }
            origin = p + ps.normal * 0.002;
            dir = reflect(dir, ps.normal);
            primary_mask = 4u | 2u;
            continue;
        }
        if (m.kind == KIND_SKY || m.kind == KIND_CONSTANT) {
            vec4 tex = textureLod(PT_TEX2D(m.albedo), ps.uv, 0.0);
            return radiance + throughput * min(vec3(32.0), m.albedo_factor.rgb * tex.rgb * m.params.y) * Saturate(m.albedo_factor.a * tex.a);
        }
        if (m.kind != KIND_DEFERRED) {
            return radiance;
        }
        vec3 n;
        PtMaterial s = PrimaryMaterial(m, ps, rayQueryGetIntersectionFrontFaceEXT(rq, true), n);
        if (pass.f0.w > 2.5) {
            vec3 sum = vec3(0.0);
            for (uint i = 0u; i < pass.ids.y; ++i) {
                Light l = frame.lights[i];
                vec3 d;
                vec3 sp;
                if (l.shadow_cone.w >= 0.0 && PtLightEval(l, p, n, -dir, s, Cutoff(), d, sp)) {
                    sum += s.albedo * d + sp;
                }
            }
            return sum;
        }
        if (pass.f0.w > 0.5) {
            return (pass.f0.w > 1.5 ? n * 0.5 + 0.5 : s.albedo) / max(v.exposure.x, 1.0e-12);
        }
        vec3 V = -dir;
        vec3 next = p + ps.normal * max(0.002, 0.001 * t);
        if (pass.f1.w > 0.5) {
            float a = PtCoatAmount(n, ps.normal, mat3(v.view) * n, pass.f1.xyz, s.roughness, pass.f2.x, pass.f2.y);
            if (a > 0.0 && RtRandom(rng) < a) {
                vec3 d = PtCoatDirection(n, ps.normal, V);
                float first_c;
                return radiance + PtTracePath(next, d, throughput, bounces, reach, 0.0, pass.ids.y, Cutoff(), rng, first_c);
            }
        }
        radiance += throughput * PtNextEvent(p, n, V, s, next, pass.ids.y, Cutoff(), rng);
        vec3 spec_albedo = PtSpecularAlbedo(n, V, s);
        float ls = Luma709(spec_albedo);
        float ld = Luma709(s.albedo);
        if (!(ls + ld > 1.0e-5)) {
            return radiance;
        }
        float p_spec = clamp(ls / (ls + ld), 0.0, 1.0);
        vec3 next_dir;
        if (RtRandom(rng) < p_spec) {
            vec3 weight;
            if (!PtSampleSpecular(n, V, s, vec2(RtRandom(rng), RtRandom(rng)), next_dir, weight)) {
                return radiance;
            }
            throughput *= weight / max(p_spec, 1.0e-4);
        } else {
            next_dir = PtCosineDirection(n, vec2(RtRandom(rng), RtRandom(rng)));
            throughput *= s.albedo / max(1.0 - p_spec, 1.0e-4);
        }
        if (dot(next_dir, ps.normal) <= 0.0) {
            return radiance;
        }
        float first;
        if (bounces == 0u) {
            return radiance;
        }
        radiance += PtTracePath(next, next_dir, throughput, bounces, reach, 0.0, pass.ids.y, Cutoff(), rng, first);
        return radiance;
    }
    return radiance;
}

#include "pt_reference_output.glsl"
