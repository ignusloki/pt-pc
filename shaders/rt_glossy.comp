#version 460
#extension GL_EXT_ray_query : require
#ifndef PT_D3D12
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference_uvec2 : require
#endif
#include "common.glsl"
#include "rt_shadow.glsl"
#include "rt_full.glsl"

layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform PassPush {
    uvec4 ids;
    vec4 f0;
    vec4 f1;
    vec4 f2;
    mat4 m;
} pass;

#include "rt_full_images.glsl"

vec3 SampleVisibleNormal(vec3 v, float alpha, vec2 u) {
    vec3 vh = normalize(vec3(alpha * v.x, alpha * v.y, v.z));
    float lensq = vh.x * vh.x + vh.y * vh.y;
    vec3 t1 = lensq > 0.0 ? vec3(-vh.y, vh.x, 0.0) * inversesqrt(lensq) : vec3(1.0, 0.0, 0.0);
    vec3 t2 = cross(vh, t1);
    float r = sqrt(u.x);
    float phi = 6.2831853 * u.y;
    float p1 = r * cos(phi);
    float p2 = r * sin(phi);
    float s = 0.5 * (1.0 + vh.z);
    p2 = (1.0 - s) * sqrt(max(0.0, 1.0 - p1 * p1)) + s * p2;
    vec3 nh = p1 * t1 + p2 * t2 + sqrt(max(0.0, 1.0 - p1 * p1 - p2 * p2)) * vh;
    return normalize(vec3(alpha * nh.x, alpha * nh.y, max(1.0e-6, nh.z)));
}

vec4 GlossyLayers(vec3 origin, vec3 ray, float t_end) {
    vec3 sum = vec3(0.0);
    float seen = 1.0;
    float t_start = 0.0;
    for (int k = 0; k < 3 && seen > 0.004; ++k) {
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, rt_casters, gl_RayFlagsCullBackFacingTrianglesEXT, 64u, origin, t_start, ray, t_end);
        while (rayQueryProceedEXT(rq)) {
            if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT) {
                rayQueryConfirmIntersectionEXT(rq);
            }
        }
        if (rayQueryGetIntersectionTypeEXT(rq, true) != gl_RayQueryCommittedIntersectionTriangleEXT) {
            break;
        }
        uint record = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
        RtSurfaceHit hs = RtFullSurface(record, rayQueryGetIntersectionPrimitiveIndexEXT(rq, true), rayQueryGetIntersectionBarycentricsEXT(rq, true),
                                        rayQueryGetIntersectionObjectToWorldEXT(rq, true), ray);
        Material m = materials[hs.material];
        if (m.kind == KIND_CONSTANT) {
            vec4 tex = textureLod(PT_TEX2D(m.albedo), hs.uv, 2.0);
            float a = Saturate(m.albedo_factor.a * tex.a);
            sum += seen * min(vec3(32.0), m.albedo_factor.rgb * tex.rgb * m.params.y) * a;
            seen *= 1.0 - a;
        }
        t_start = rayQueryGetIntersectionTEXT(rq, true) + 1.0e-3;
        if (!(t_start < t_end)) {
            break;
        }
    }
    return vec4(sum, seen);
}

void main() {
    View v = frame.views[pass.ids.x];
    ivec2 half_pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(v.viewport.xy);
    ivec2 half_size = (size + 1) / 2;
    if (half_pixel.x >= half_size.x || half_pixel.y >= half_size.y) {
        return;
    }
    ivec2 pixel = min(half_pixel * 2, size - 1);
    float depth = ImgFetch(IMG_DEPTH, pixel).x;
    vec4 g_material = ImgFetch(IMG_MATERIAL, pixel);
    float roughness = g_material.x;
    vec4 mat0 = Img(RES_MATERIAL, SMP_POINT_CLAMP, vec2(g_material.z, 0.25));
    if (depth <= 0.0 || roughness > pass.f0.z || g_material.y * Luma709(mat0.rgb) < 0.004) {
        imageStore(rt_glossy_raw, half_pixel, vec4(0.0, 0.0, 0.0, -1.0));
        return;
    }
    mat3 to_world = mat3(v.inv_view);
    vec3 n = normalize(to_world * DecodeNormal(ImgFetch(IMG_NORMAL, pixel).xyz));
    if (pass.f0.w > 0.5 && dot(n, pass.f1.xyz) >= 0.9) {
        imageStore(rt_glossy_raw, half_pixel, vec4(0.0, 0.0, 0.0, -1.0));
        return;
    }
    vec3 c = ViewPosition(v, PixelNdc(v, vec2(pixel) + 0.5), depth);
    vec3 ng = normalize(to_world * RtFaceNormal(v, pixel, size, c));
    vec3 world = (v.inv_view * vec4(c, 1.0)).xyz;
    vec3 view_dir = normalize(v.eye.xyz - world);
    if (dot(n, view_dir) <= 0.0) {
        n = ng;
    }
    uint rng = RtHash(uint(half_pixel.x) * 1973u + uint(half_pixel.y) * 9277u) ^ RtHash(pass.ids.z * 26699u + 7u);
    vec3 t = normalize(cross(n, abs(n.y) < 0.99 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0)));
    vec3 b = cross(n, t);
    vec3 v_tangent = vec3(dot(view_dir, t), dot(view_dir, b), dot(view_dir, n));
    float alpha = max(roughness * roughness, 0.002);
    vec3 h_tangent = SampleVisibleNormal(v_tangent, alpha, vec2(RtRandom(rng), RtRandom(rng)));
    vec3 h = t * h_tangent.x + b * h_tangent.y + n * h_tangent.z;
    vec3 dir = reflect(-view_dir, h);
    if (dot(dir, ng) <= 0.0) {
        dir = reflect(-view_dir, n);
        if (dot(dir, ng) <= 0.0) {
            dir = normalize(dir - 2.0 * dot(dir, ng) * ng);
        }
    }
    vec3 origin = world + ng * max(0.003, 0.0015 * c.z);
    float reach = pass.f0.x;
    vec3 result = vec3(0.0);
    float travel = reach;
    if (RtRayValid(origin, dir, reach)) {
        rayQueryEXT rq;
        rayQueryInitializeEXT(rq, rt_casters, gl_RayFlagsCullBackFacingTrianglesEXT, kRtReflectMask, origin, 0.0, dir, reach);
        while (rayQueryProceedEXT(rq)) {
            if (rayQueryGetIntersectionTypeEXT(rq, false) == gl_RayQueryCandidateIntersectionTriangleEXT &&
                RtCasterOpaque(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, false), rayQueryGetIntersectionPrimitiveIndexEXT(rq, false),
                               rayQueryGetIntersectionBarycentricsEXT(rq, false))) {
                rayQueryConfirmIntersectionEXT(rq);
            }
        }
        if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
            travel = rayQueryGetIntersectionTEXT(rq, true);
            uint record = rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true);
            RtSurfaceHit hs = RtFullSurface(record, rayQueryGetIntersectionPrimitiveIndexEXT(rq, true), rayQueryGetIntersectionBarycentricsEXT(rq, true),
                                            rayQueryGetIntersectionObjectToWorldEXT(rq, true), dir);
            Material m = materials[hs.material];
            vec3 hit = origin + dir * travel;
            if (m.kind == KIND_CONSTANT || m.kind == KIND_SKY) {
                vec4 tex = textureLod(PT_TEX2D(m.albedo), hs.uv, 2.0);
                result = min(vec3(32.0), m.albedo_factor.rgb * tex.rgb * m.params.y) * Saturate(m.albedo_factor.a * tex.a);
            } else if (m.kind == KIND_DEFERRED) {
                vec3 albedo = (m.flags & MAT_CONSTANT_COLOR) != 0u ? m.albedo_factor.rgb : textureLod(PT_TEX2D(m.albedo), hs.uv, 2.0).rgb;
                vec3 ambient = RtFullAmbient(hit, hs.normal, pass.ids.w);
                result = albedo * (ambient + RtFullDirect(hit, hs.normal, pass.ids.y, false, rng, vec2(half_pixel), v.exposure.w));
            }
        }
        vec4 layers = GlossyLayers(origin, dir, travel);
        result = (layers.rgb + layers.a * result) * (1.0 - smoothstep(pass.f0.y, reach, travel));
    }
    if (any(isnan(result)) || any(isinf(result))) {
        result = vec3(0.0);
    }
    imageStore(rt_glossy_raw, half_pixel, vec4(min(result, vec3(64.0)), travel));
}
