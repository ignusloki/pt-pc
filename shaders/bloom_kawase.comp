#version 460
#extension GL_EXT_shader_image_load_formatted : require
#include "common.glsl"

/* kawase.frag (ids.z 0, bloom A into B) and kawase_sum.frag (ids.z 1, bloom B into A and the sum) as dispatches, with the same samples
   and arithmetic. The bloom targets are a few hundred pixels across, so as render passes the chain spent most of its time starting and
   draining passes. The sRGB views keep the encode and decode in hardware, and the sum target's additive blend becomes load, add and
   store (ids.w 1 marks the cleared first step). */
layout(local_size_x = 8, local_size_y = 8) in;

layout(push_constant) uniform PassPush {
    uvec4 ids;
    vec4 f0;
    vec4 f1;
    vec4 f2;
    mat4 m;
} pass;

layout(set = 1, binding = 6) uniform image2D bloom_images[3];

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(bloom_images[0]);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    vec2 in_uv = (vec2(pixel) + 0.5) / vec2(size);
    uint source = pass.ids.x;
    vec2 texel = 1.0 / ImgSize(source);
    vec2 o = texel * pass.f0.x;
    vec4 c = ImgLod(source, SMP_LINEAR_CLAMP, in_uv + vec2(-o.x, -o.y), 0.0);
    c += ImgLod(source, SMP_LINEAR_CLAMP, in_uv + vec2(o.x, -o.y), 0.0);
    c += ImgLod(source, SMP_LINEAR_CLAMP, in_uv + vec2(-o.x, o.y), 0.0);
    c += ImgLod(source, SMP_LINEAR_CLAMP, in_uv + vec2(o.x, o.y), 0.0);
    c *= 0.25 * pass.f0.y;
    if (pass.ids.z == 0u) {
        imageStore(bloom_images[1], pixel, pass.f0.z > 0.0 ? clamp(c, 0.0, 1.0) : c);
        return;
    }
    vec4 out_blur = clamp(c, 0.0, 1.0);
    imageStore(bloom_images[0], pixel, out_blur);
    vec4 stored = vec4(SrgbDecode(round(SrgbEncode(out_blur.rgb) * 255.0) / 255.0), round(out_blur.a * 255.0) / 255.0);
    vec4 sum = stored;
    sum += stored;
    sum += stored;
    sum += stored;
    vec4 out_sum = sum * (0.25 * pass.f1.x);
    vec4 previous = pass.ids.w != 0u ? vec4(0.0) : imageLoad(bloom_images[2], pixel);
    imageStore(bloom_images[2], pixel, vec4(out_sum.rgb + previous.rgb, previous.a));
}
