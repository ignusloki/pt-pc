#version 460
#include "common.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
layout(push_constant) uniform PassPush {
    uvec4 ids;
    vec4 f0;
    vec4 f1;
    vec4 f2;
    mat4 m;
} pass;
layout(std430, set = 1, binding = 5) buffer LuminanceOut { vec2 partial[]; };
void main() {
    ivec2 cell = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(cell, ivec2(32)))) return;
    ivec2 size = ivec2(ImgSize(IMG_DIFFUSE));
    float sum = 0.0, weight = 0.0;
    // Distributed 128x128 grid; no FP16 re-quantization or log offset.
    for (int y = 0; y < 4; ++y) for (int x = 0; x < 4; ++x) {
        vec2 uv = (vec2(cell * 4 + ivec2(x, y)) + 0.5) / 128.0;
        ivec2 p = min(ivec2(uv * vec2(size)), size - 1);
        float depth = ImgFetch(IMG_DEPTH, p).x;
        vec3 c = ImgFetch(IMG_DIFFUSE, p).rgb;
        float l = dot(max(c, vec3(0.0)), vec3(0.2126, 0.7152, 0.0722));
        if (depth > 0.0 && !isnan(l) && !isinf(l)) {
            vec2 center = uv * 2.0 - 1.0;
            float w = 0.25 + 0.75 * exp(-2.0 * dot(center, center));
            sum += l * w;
            weight += w;
        }
    }
    partial[cell.y * 32 + cell.x] = vec2(weight > 0.0 ? sum / weight : 0.0, weight);
}
